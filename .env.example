# FORMATO (importante): uma variável por linha, NOME=valor. O nome só pode ter letras, números e "_"
# (um "-" no nome, como DATABASE-URL, derruba a leitura do arquivo pela CLI do Supabase). Sem "export".
# Valores com espaço ou "#" vão entre aspas. Confira com: pnpm env:verificar
# Supabase (hoje só o esqueleto; uso real a partir do dia 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas no servidor. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (apenas no servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Contas de teste (scripts/criar-usuarios.ts e pnpm test:rls)
SEED_EMAIL_ALINE=
SEED_EMAIL_KELY=
SEED_EMAIL_GERENCIA=
SEED_EMAIL_DONO=
SEED_SENHA_INICIAL=

# Senha do banco (supabase link / db push). Só local.
SUPABASE_DB_PASSWORD=

# IA (dia 5). Chave só no servidor. Preços em US$ por milhão de tokens, só para estimar custo.
IA_LIMITE_DIARIO_VENDEDORA=20
IA_MAX_GERACOES_POR_ORCAMENTO=3
IA_PRECO_ENTRADA_USD_MTOK=
IA_PRECO_SAIDA_USD_MTOK=
# Opcional: low, medium ou high
IA_RACIOCINIO=

# Contas reais do piloto/go-live (pnpm usuarios:reais). Preencha só quando for criar as contas.
REAL_EMAIL_ALINE=
REAL_EMAIL_KELY=
REAL_EMAIL_GERENCIA=
REAL_EMAIL_DONO=
