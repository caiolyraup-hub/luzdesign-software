{
  "name": "luz-design-orcamentos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "usuarios": "tsx --env-file=.env.local scripts/criar-usuarios.mts",
    "test:rls": "tsx --env-file=.env.local scripts/testar-isolamento.mts && tsx --conditions=react-server --env-file=.env.local scripts/testar-montagem-ia.mts",
    "catalogo:provisorio": "tsx --env-file=.env.local scripts/catalogo-provisorio.mts",
    "test:e2e": "playwright test",
    "ia:testar": "tsx --conditions=react-server --env-file=.env.local scripts/ia-testar.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "next": "16.4.4",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
